DISCORD_TOKEN=your_discord_bot_token_here
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional environment-only policy for container deployments. These values
# override config.json when present. Comma-separate multiple IDs.
DISCORD_DEFAULT_GUILD_ID=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOWED_DM_USER_IDS=
DISCORD_ALLOWED_MENTION_USER_IDS=

# stdio (default), http, or streamable-http. "sse" remains a deprecated alias.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=3001
# If MCP_PORT is unset, Railway's PORT is used automatically.

# Required in HTTP mode. Generate at least 24 random characters and keep it secret.
MCP_HTTP_BEARER_TOKEN=
# Exact comma-separated browser origins; no wildcard. Empty permits non-browser clients only.
MCP_ALLOWED_ORIGINS=
# Maximum JSON request body (1 MiB default, 4 MiB hard configuration ceiling).
MCP_JSON_LIMIT_BYTES=1048576
# Global MCP requests per minute. A reverse proxy should enforce its own limits too.
MCP_RATE_LIMIT_PER_MINUTE=60
# Optional absolute path to another config file.
MCP_CONFIG_PATH=

# --- Discord -> Letta custom-channel bridge (all optional, disabled by default) ---
# Master switch for inbound messageCreate handling and /bridge endpoints.
# Requires MCP_TRANSPORT=http and an explicit policy allowlist when enabled.
DISCORD_BRIDGE_ENABLED=false
# Dedicated secret for /bridge endpoints. MUST be at least 32 characters and
# MUST differ from MCP_HTTP_BEARER_TOKEN. Generate independently.
DISCORD_BRIDGE_BEARER_TOKEN=
# Comma-separated Discord user IDs whose DMs may be bridged inbound.
# DMs are deny-by-default; this list is separate from DISCORD_ALLOWED_DM_USER_IDS.
DISCORD_BRIDGE_DM_USER_IDS=
# Optional inbound-only comma-separated channel/thread IDs. Use this to stage
# the bridge in a test channel without narrowing the outbound MCP policy.
DISCORD_BRIDGE_CHANNEL_IDS=
# Optional comma-separated guild role IDs whose mention deliberately wakes the
# bridge. Unlisted role mentions remain ignored.
DISCORD_BRIDGE_ROLE_IDS=
# Whether @everyone and @here deliberately wake the bridge. Default false.
DISCORD_BRIDGE_ALLOW_EVERYONE=false
# In-memory event queue capacity. When full, NEW events are dropped (counted,
# never silently) — already-delivered events are never displaced.
DISCORD_BRIDGE_QUEUE_LIMIT=256
# Long-poll timeout for GET /bridge/events?wait=1, in milliseconds.
DISCORD_BRIDGE_POLL_TIMEOUT_MS=20000
# JSON body limit for /bridge/send and /bridge/ack.
DISCORD_BRIDGE_JSON_LIMIT_BYTES=65536
# Requests per minute across /bridge endpoints.
DISCORD_BRIDGE_RATE_LIMIT_PER_MINUTE=120
