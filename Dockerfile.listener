FROM node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    python3 \
  && rm -rf /var/lib/apt/lists/*

COPY deploy/continuity-listener/vendor/letta-code /opt/vendor/letta-code
RUN cd /opt/vendor/letta-code \
  && sha256sum --check SHA256SUMS \
  && npm install --global ./letta-ai-letta-code-0.34.24.tgz \
  && test "$(letta --version)" = "0.34.24 (Letta Code)" \
  && rm -rf /opt/vendor/letta-code

WORKDIR /app

# Production's listener service is connected to the repository root so both
# bridge and listener deployments carry one auditable Git revision. Keep these
# paths root-relative; the template-specific Dockerfile remains usable from
# deploy/continuity-listener as its isolated service root.
COPY deploy/continuity-listener/entrypoint.mjs /app/entrypoint.mjs
COPY deploy/continuity-listener/channel-reply-route-guard.ts /app/channel-reply-route-guard.ts
COPY deploy/continuity-listener/proactive-discord.ts /app/proactive-discord.ts
COPY deploy/continuity-listener/proactive-telegram.ts /app/proactive-telegram.ts
COPY deploy/continuity-listener/continuity-discord/plugin.mjs /app/continuity-discord/plugin.mjs
COPY deploy/continuity-listener/container-entrypoint.sh /usr/local/bin/continuity-listener-entrypoint

ENV NODE_ENV=production \
    LETTA_BASE_URL=https://api.letta.com \
    LETTA_CHANNEL_CREDENTIALS_STORE=file \
    LETTA_RESTORE_ENABLED_CHANNELS=1 \
    LETTA_LOCAL_BACKEND_EXPERIMENTAL=0

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/continuity-listener-entrypoint"]
CMD ["node", "/app/entrypoint.mjs"]
