# Letta Cloud target. Use an API key that can access the selected agent.
LETTA_API_KEY=
LETTA_BASE_URL=https://api.letta.com
LETTA_AGENT_ID=agent-00000000-0000-0000-0000-000000000000
LETTA_CONVERSATION_ID=default
LETTA_ENV_NAME=continuity-railway

# Telegram: one private chat routed into the same conversation.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ACCOUNT_ID=continuity-main
TELEGRAM_DISPLAY_NAME=Continuity Telegram
TELEGRAM_RICH_MESSAGES=false

# Discord custom channel: bridge service plus exact channel routes.
DISCORD_BRIDGE_BASE_URL=http://discord-bridge.railway.internal:3001
DISCORD_BRIDGE_BEARER_TOKEN=
DISCORD_CHANNEL_IDS=
DISCORD_ACCOUNT_ID=continuity-main
DISCORD_DISPLAY_NAME=Continuity Discord

# Railway injects PORT. Set only for non-Railway testing.
PORT=3000

# Write state and exit without starting Letta. Intended for validation only.
SEED_ONLY=0
